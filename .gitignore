*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code. Ignored so editor extensions (e.g. an apiKey written to
# settings.json) cannot dirty the repo or leak credentials into history.
.vscode/

